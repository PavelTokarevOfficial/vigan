APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://finde:finde@localhost:5432/finde?sslmode=disable
S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=finde-media
S3_REGION=us-east-1
S3_USE_SSL=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
FFMPEG_BIN_PATH=ffmpeg
WHISPER_BIN_PATH=whisper-cli
WHISPER_MODEL_PATH=/models/ggml-tiny.bin
BROWSER_HEADLESS=true
BROWSER_BIN_PATH=/usr/bin/chromium
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
BACKGROUND_BLUR=25
FFMPEG_PRESET=veryfast
